{
  "id": "acme.history-aware",
  "slug": "history-aware",
  "name": "History Aware",
  "description": "Example conversation-aware plugin with optional runtime-local PostgreSQL.",
  "version": "1.0.0",
  "publisher": "acme",
  "runtime": "container",
  "entrypoint": "container",
  "execution": {
    "type": "container",
    "placement": "either",
    "protocol": "openleash-container-plugin.v1",
    "image": "ghcr.io/acme/history-aware:1.0.0",
    "healthPath": "/healthz",
    "eventPath": "/v1/events",
    "transformPath": "/v1/transform",
    "toolExecutePath": "/v1/tools/execute",
    "timeoutMs": 30000,
    "failureMode": "closed",
    "isolation": "user-dedicated",
    "resources": {
      "memoryMb": 256,
      "cpuShares": 256
    },
    "storage": {
      "persistent": true
    }
  },
  "events": [
    "session.started",
    "prompt.beforeSubmit"
  ],
  "permissions": [
    "event:read",
    "conversation:read",
    "network:access",
    "log:write"
  ],
  "effects": [
    "observe"
  ],
  "ordering": {
    "priority": 300
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      }
    }
  },
  "defaultConfig": {
    "label": "remembered"
  }
}
