FROM node:22-alpine

RUN apk add --no-cache postgresql postgresql-client \
  && addgroup -S plugin \
  && adduser -S -G plugin -h /app plugin

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server.mjs ./
COPY --chmod=755 entrypoint-bundled-postgres.sh /usr/local/bin/openleash-plugin-entrypoint

RUN mkdir -p /data /tmp/postgresql \
  && chown -R plugin:plugin /app /data /tmp/postgresql

USER plugin

ENV NODE_ENV=production
ENV PORT=8080
ENV PGDATA=/data/postgres
ENV DATABASE_URL=postgresql://plugin@127.0.0.1:5432/plugin

EXPOSE 8080
VOLUME ["/data"]

HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/openleash-plugin-entrypoint"]
